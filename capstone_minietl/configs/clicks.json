{
  "source": {
    "type": "dated_files",
    "path": "capstone_minietl/data/incoming/clicks",
    "pattern": "clicks_(?P<date>\\d{4}-\\d{2}-\\d{2})\\.jsonl",
    "format": "jsonl"
  },
  "transforms": [
    {"type": "require", "columns": ["user_id", "timestamp", "url"]},
    {"type": "normalise_ts", "column": "timestamp", "source_tz": "UTC"}
  ],
  "checks": [
    {"type": "not_null", "column": "user_id"},
    {"type": "matches_pattern", "column": "url", "regex": "/.*", "severity": "warning"}
  ],
  "sink": {"type": "partitioned_jsonl", "path": "capstone_minietl/out/clicks", "ts_column": "timestamp"},
  "state": "capstone_minietl/out/state/clicks.json",
  "quarantine": "capstone_minietl/out/quarantine/clicks",
  "reports": "capstone_minietl/out/reports/clicks"
}
